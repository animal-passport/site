# Copy to .env (development) or .env.production (build) and fill in.

# Where the contact form posts: the endpoint on resources.trackssoftware.com.
PUBLIC_CONTACT_ENDPOINT=https://resources.trackssoftware.com/api/animal-passport/contact

# Optional: Cloudflare Turnstile site key (public), only if spam gets through. Set it
# together with TURNSTILE_SECRET_KEY on resources.trackssoftware.com; leave both empty to skip.
# For local testing, Cloudflare's always-pass test key is 1x00000000000000000000AA.
PUBLIC_TURNSTILE_SITE_KEY=
