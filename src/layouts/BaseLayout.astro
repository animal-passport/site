---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import FontFaces from "../components/FontFaces.astro";
import { withBase } from "../lib/paths";

interface Props {
  title: string;
  description: string;
  /** Path component for canonical URL — defaults to Astro.url.pathname. */
  canonicalPath?: string;
  /** Open Graph image absolute path, e.g. "/og-image.png". */
  ogImage?: string;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  ogImage = withBase("/og-image.png"),
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://animalpassport.org");
const canonical = new URL(canonicalPath, siteUrl).toString();
const ogImageUrl = new URL(ogImage, siteUrl).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Animal Passport" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />

    <link
      rel="preload"
      href={withBase("/fonts/SourceSerif4.woff2")}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={withBase("/fonts/Inter.woff2")}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <FontFaces />
  </head>
  <body class="font-sans bg-cream-50 text-ink-900">
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
