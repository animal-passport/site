---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---
<section class="bg-cream-50 pt-16 md:pt-24 pb-10 md:pb-14">
  <div class="mx-auto max-w-3xl px-6">
    {eyebrow && (
      <p class="text-xs font-semibold tracking-[0.14em] uppercase text-teal-700">
        {eyebrow}
      </p>
    )}
    <h1
      class="mt-4 font-serif text-navy-900 text-[clamp(2.25rem,4.5vw,3.25rem)] leading-[1.08] tracking-tight"
      style="font-variation-settings: 'opsz' 60;"
    >
      {title}
    </h1>
    {lede && (
      <p class="mt-6 text-navy-700 text-[1.075rem] leading-relaxed">{lede}</p>
    )}
  </div>
</section>
